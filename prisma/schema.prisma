generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ATTENDANT
  MECHANIC
  MANAGER

  @@map("user_role")
}

model User {
  id           String   @id @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Customer {
  id        String    @id @db.Uuid
  name      String
  document  String    @db.VarChar(14)
  email     String?
  phone     String?   @db.VarChar(11)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  vehicles  Vehicle[]

  @@unique([document], where: { deletedAt: null })
  @@map("customers")
}

model Vehicle {
  id         String    @id @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  plate      String    @db.VarChar(7)
  brand      String    @db.VarChar(60)
  model      String    @db.VarChar(60)
  year       Int       @db.SmallInt
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([plate], where: { deletedAt: null })
  @@index([customerId])
  @@map("vehicles")
}

model Service {
  id               String   @id @db.Uuid
  name             String   @db.VarChar(100)
  description      String?
  priceCents       Int      @map("price_cents")
  estimatedMinutes Int      @map("estimated_minutes")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("services")
}

enum PartType {
  PART
  SUPPLY

  @@map("part_type")
}

model Part {
  id         String   @id @db.Uuid
  name       String   @db.VarChar(100)
  type       PartType
  priceCents Int      @map("price_cents")
  quantity   Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("parts")
}

enum ServiceOrderStatus {
  RECEIVED
  IN_DIAGNOSIS
  AWAITING_APPROVAL
  IN_EXECUTION
  FINISHED
  DELIVERED

  @@map("service_order_status")
}

enum QuoteDecision {
  APPROVED
  REJECTED

  @@map("quote_decision")
}

model ServiceOrder {
  id          String             @id @db.Uuid
  number      Int                @unique @default(autoincrement())
  customerId  String             @map("customer_id") @db.Uuid
  vehicleId   String             @map("vehicle_id") @db.Uuid
  status      ServiceOrderStatus
  deliveredAt DateTime?          @map("delivered_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  serviceItems  ServiceOrderServiceItem[]
  partItems     ServiceOrderPartItem[]
  quotes        ServiceOrderQuote[]
  statusHistory ServiceOrderStatusChange[]

  @@unique([vehicleId], where: { deliveredAt: null })
  @@index([customerId])
  @@index([status])
  @@map("service_orders")
}

model ServiceOrderServiceItem {
  serviceOrderId String @map("service_order_id") @db.Uuid
  position       Int
  serviceId      String @map("service_id") @db.Uuid
  name           String @db.VarChar(100)
  priceCents     Int    @map("price_cents")
  quoteVersion   Int    @map("quote_version")

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@id([serviceOrderId, position])
  @@map("service_order_service_items")
}

model ServiceOrderPartItem {
  serviceOrderId String @map("service_order_id") @db.Uuid
  position       Int
  partId         String @map("part_id") @db.Uuid
  name           String @db.VarChar(100)
  unitPriceCents Int    @map("unit_price_cents")
  quantity       Int
  quoteVersion   Int    @map("quote_version")

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@id([serviceOrderId, position])
  @@map("service_order_part_items")
}

model ServiceOrderQuote {
  serviceOrderId  String         @map("service_order_id") @db.Uuid
  version         Int
  totalCents      Int            @map("total_cents")
  generatedAt     DateTime       @map("generated_at")
  decision        QuoteDecision?
  decidedAt       DateTime?      @map("decided_at")
  rejectionReason String?        @map("rejection_reason")

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@id([serviceOrderId, version])
  @@map("service_order_quotes")
}

model ServiceOrderStatusChange {
  serviceOrderId String              @map("service_order_id") @db.Uuid
  position       Int
  fromStatus     ServiceOrderStatus? @map("from_status")
  toStatus       ServiceOrderStatus  @map("to_status")
  changedAt      DateTime            @map("changed_at")

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@id([serviceOrderId, position])
  @@map("service_order_status_history")
}
