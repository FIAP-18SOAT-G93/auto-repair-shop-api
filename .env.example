# Aplicação: development | production | test
NODE_ENV=development
PORT=3000

# Conexão com o PostgreSQL: postgresql://usuario:senha@host:porta/banco?schema=public
DATABASE_URL=postgresql://usuario:senha@localhost:5432/banco?schema=public

# Autenticação
# Segredo do JWT com no mínimo 32 caracteres.
# Para gerar um: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres
# Validade do token: número + unidade (s, m, h, d). Ex.: 15m, 1h, 7d
JWT_EXPIRES_IN=1h
