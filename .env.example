# Aplicação: development | production | test
NODE_ENV=development
PORT=3000

# Conexão com o PostgreSQL
# Os mesmos valores criam o banco no docker-compose e conectam a API rodando
# fora do Docker (npm run start:dev). Dentro do Docker, o host é sempre o
# serviço "postgres", definido no docker-compose.yml.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=db_name

# Autenticação
# Segredo do JWT com no mínimo 32 caracteres.
# Para gerar um: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres
# Validade do token: número + unidade (s, m, h, d). Ex.: 15m, 1h, 7d
JWT_EXPIRES_IN=1h
