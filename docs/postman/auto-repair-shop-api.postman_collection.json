  },
  "item": [
    {
      "name": "0. Saúde da API",
      "item": [
        {
          "name": "Saúde da API",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API e banco no ar', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
