    {
      "name": "2. Abertura da OS",
      "item": [
        {
          "name": "Atendente abre a OS com cliente e veículo novos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/service-orders",
              "host": ["{{baseUrl}}"],
              "path": ["service-orders"]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{attendantToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"document\": \"{{customerDocument}}\",\n    \"name\": \"Maria da Silva\",\n    \"email\": \"maria@exemplo.com\",\n    \"phone\": \"(11) 98765-4321\"\n  },\n  \"vehicle\": {\n    \"plate\": \"{{vehiclePlate}}\",\n    \"brand\": \"Volkswagen\",\n    \"model\": \"Gol\",\n    \"year\": 2020\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Na primeira execução, cadastra o cliente e o veículo. Nas seguintes, reaproveita os dois cadastros. A resposta traz o trackingCode do recibo do cliente."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('OS aberta', () => pm.response.to.have.status(201));",
                  "pm.test('OS em RECEIVED', () => pm.expect(pm.response.json().status).to.eql('RECEIVED'));",
                  "const order = pm.response.json();",
                  "pm.collectionVariables.set('orderId', order.id);",
                  "pm.collectionVariables.set('trackingCode', order.trackingCode);"
                ]
              }
            }
          ]
        }
      ]
    },
